/**
 * ADVANTOUR — Input Validation Middleware
 * Uses Joi for schema validation.
 */

'use strict';

const Joi = require('joi');

const validate = (schema) => (req, res, next) => {
  const { error } = schema.validate(req.body, { abortEarly: false });
  if (error) {
    return res.status(422).json({
      error: 'Validation failed',
      details: error.details.map(d => ({ field: d.path.join('.'), message: d.message })),
    });
  }
  next();
};

const tourSchema = {
  create: Joi.object({
    deal_id:            Joi.string().uuid().required(),
    title:              Joi.string().min(3).max(200).required(),
    start_date:         Joi.string().isoDate().required(),
    end_date:           Joi.string().isoDate().required(),
    destination:        Joi.string().max(200).required(),
    pax_count:          Joi.number().integer().min(1).max(500).required(),
    transport_type:     Joi.string().valid('bus', 'van', 'train', 'flight', 'mixed').required(),
    guide_requirements: Joi.object().optional(),
    notes:              Joi.string().max(2000).optional(),
  }),
  update: Joi.object({
    title:      Joi.string().min(3).max(200),
    start_date: Joi.string().isoDate(),
    end_date:   Joi.string().isoDate(),
    status:     Joi.string().valid('pending', 'active', 'completed', 'cancelled'),
    notes:      Joi.string().max(2000),
  }).min(1),
};

module.exports = { validate, tourSchema };