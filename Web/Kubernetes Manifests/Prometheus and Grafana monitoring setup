# ─────────────────────────────────────────────────────────────────────────────
# ADVANTOUR — Monitoring Stack: Prometheus + Grafana
#
# Prometheus:  Scrapes metrics from all pods every 15 seconds.
#              Fires alerts when thresholds are exceeded.
#
# Grafana:     Visualizes Prometheus data on dashboards.
#              Your team opens a browser at http://grafana.advantour.com
#              and sees real-time charts for CPU, memory, API errors, etc.
#
# HOW TO INSTALL (using Helm — easiest approach):
#   helm repo add prometheus-community https://prometheus-community.github.io/helm-charts
#   helm repo update
#   helm install kube-prometheus-stack prometheus-community/kube-prometheus-stack \
#     --namespace monitoring \
#     --create-namespace \
#     --values monitoring/prometheus/helm-values.yaml
#
# HOW TO ACCESS GRAFANA:
#   kubectl port-forward svc/kube-prometheus-stack-grafana 3001:80 -n monitoring
#   Then open: http://localhost:3001
#   Default credentials: admin / prom-operator (change immediately)
# ─────────────────────────────────────────────────────────────────────────────

# monitoring/prometheus/helm-values.yaml
# This file customizes the kube-prometheus-stack Helm chart for Advantour.

grafana:
  enabled: true
  adminPassword: "CHANGE_ME_STRONG_PASSWORD"  # Change this before deploying!

  # Persist Grafana dashboard configs across pod restarts
  persistence:
    enabled: true
    size: 5Gi

  ingress:
    enabled: true
    annotations:
      kubernetes.io/ingress.class: nginx
      cert-manager.io/cluster-issuer: letsencrypt-prod
    hosts:
      - grafana.advantour.com
    tls:
      - secretName: grafana-tls
        hosts:
          - grafana.advantour.com

  # Pre-provision Advantour datasource so team doesn't have to configure manually
  datasources:
    datasources.yaml:
      apiVersion: 1
      datasources:
        - name: Prometheus
          type: prometheus
          url: http://kube-prometheus-stack-prometheus:9090
          isDefault: true

prometheus:
  enabled: true
  prometheusSpec:
    # Scrape every 15 seconds
    scrapeInterval: "15s"
    evaluationInterval: "15s"

    # Keep 30 days of metrics data
    retention: "30d"

    # Persistent storage so metrics survive pod restarts
    storageSpec:
      volumeClaimTemplate:
        spec:
          accessModes: ["ReadWriteOnce"]
          resources:
            requests:
              storage: 50Gi

    # Tell Prometheus to also scrape pods with annotation prometheus.io/scrape: "true"
    additionalScrapeConfigs:
      - job_name: advantour-api
        kubernetes_sd_configs:
          - role: pod
            namespaces:
              names: [advantour-prod, advantour-staging, advantour-dev]
        relabel_configs:
          - source_labels: [__meta_kubernetes_pod_annotation_prometheus_io_scrape]
            action: keep
            regex: "true"
          - source_labels: [__meta_kubernetes_pod_annotation_prometheus_io_path]
            target_label: __metrics_path__
          - source_labels: [__meta_kubernetes_pod_annotation_prometheus_io_port, __address__]
            target_label: __address__
            regex: (.+);([^:]+)(?::\d+)?
            replacement: $2:$1

alertmanager:
  enabled: true
  config:
    global:
      smtp_smarthost: 'smtp.gmail.com:587'
      smtp_from: 'alerts@advantour.com'
      smtp_auth_username: 'alerts@advantour.com'
      smtp_auth_password: 'CHANGE_ME_SMTP_PASSWORD'

    route:
      group_by: ['alertname', 'namespace']
      group_wait:      30s
      group_interval:  5m
      repeat_interval: 4h
      receiver: 'advantour-team'
      routes:
        # Critical alerts go to on-call immediately
        - match:
            severity: critical
          receiver: 'advantour-oncall'
          repeat_interval: 1h

    receivers:
      - name: 'advantour-team'
        email_configs:
          - to: 'it-team@advantour.com'
            send_resolved: true

      - name: 'advantour-oncall'
        email_configs:
          - to: 'it-lead@advantour.com'
            send_resolved: true
        # Add Slack or Telegram webhook here if needed:
        # slack_configs:
        #   - api_url: 'https://hooks.slack.com/services/YOUR/WEBHOOK/URL'
        #     channel: '#alerts-critical'