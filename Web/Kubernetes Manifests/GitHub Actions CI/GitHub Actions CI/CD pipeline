# ─────────────────────────────────────────────────────────────────────────────
# ADVANTOUR — GitHub Actions CI/CD Pipeline
#
# This file lives at: .github/workflows/deploy.yml
#
# WHAT IT DOES:
#   1. On every push to 'develop' branch → deploy to DEV environment
#   2. On every push to 'staging' branch → deploy to STAGING environment
#   3. On git tag push (v*.*.*) →          deploy to PRODUCTION environment
#
# REQUIRED GITHUB SECRETS (set in GitHub repo → Settings → Secrets):
#   DOCKER_REGISTRY_URL      — your container registry URL
#   DOCKER_REGISTRY_USER     — registry login username
#   DOCKER_REGISTRY_PASSWORD — registry login password
#   KUBECONFIG_DEV           — kubectl config file for dev cluster (base64 encoded)
#   KUBECONFIG_STAGING       — kubectl config for staging cluster
#   KUBECONFIG_PROD          — kubectl config for prod cluster
#   SONAR_TOKEN              — SonarQube token for code quality scan (optional)
#
# HOW TO ADD A SECRET TO GITHUB:
#   Go to: https://github.com/your-org/advantour/settings/secrets/actions
#   Click "New repository secret"
# ─────────────────────────────────────────────────────────────────────────────

name: Advantour CI/CD Pipeline

on:
  push:
    branches:
      - develop      # Triggers dev deploy
      - staging      # Triggers staging deploy
    tags:
      - 'v*.*.*'     # Triggers production deploy (e.g., v1.2.3)
  pull_request:
    branches:
      - develop
      - staging
      - main

jobs:

  # ── Job 1: Test & Lint ──────────────────────────────────────────────────────
  test:
    name: Run Tests & Lint
    runs-on: ubuntu-latest

    services:
      # Spin up a real PostgreSQL for integration tests
      postgres:
        image: postgres:15-alpine
        env:
          POSTGRES_DB:       advantour_test
          POSTGRES_USER:     test_user
          POSTGRES_PASSWORD: test_password
        options: >-
          --health-cmd pg_isready
          --health-interval 10s
          --health-timeout 5s
          --health-retries 5
        ports:
          - 5432:5432

      # Spin up real Redis for cache tests
      redis:
        image: redis:7-alpine
        options: >-
          --health-cmd "redis-cli ping"
          --health-interval 10s
        ports:
          - 6379:6379

    steps:
      - name: Checkout code
        uses: actions/checkout@v4
        # What this does: downloads your code from GitHub onto the CI runner machine

      - name: Setup Node.js 20
        uses: actions/setup-node@v4
        with:
          node-version: '20'
          cache: 'npm'
          cache-dependency-path: backend/package-lock.json
        # cache: 'npm' stores node_modules in GitHub cache.
        # On repeat runs, npm install is 90% faster.

      - name: Install dependencies
        working-directory: ./backend
        run: npm ci
        # 'npm ci' is stricter than 'npm install' — it fails if package-lock.json is out of sync.
        # This prevents "works on my machine but not in CI" problems.

      - name: Run ESLint
        working-directory: ./backend
        run: npm run lint
        # Catches code style violations and common bugs before they reach the database.

      - name: Run database migrations
        working-directory: ./backend
        env:
          DB_HOST:     localhost
          DB_PORT:     5432
          DB_NAME:     advantour_test
          DB_USER:     test_user
          DB_PASSWORD: test_password
          DB_SSL:      false
        run: |
          # Apply schema to the test database
          PGPASSWORD=test_password psql \
            -h localhost -U test_user -d advantour_test \
            -f ../db/migrations/001_initial_schema.sql

      - name: Run tests
        working-directory: ./backend
        env:
          NODE_ENV:    test
          DB_HOST:     localhost
          DB_PORT:     5432
          DB_NAME:     advantour_test
          DB_USER:     test_user
          DB_PASSWORD: test_password
          DB_SSL:      false
          REDIS_HOST:  localhost
          REDIS_PORT:  6379
          JWT_SECRET:  test-jwt-secret-for-ci-only
        run: npm run test:cover
        # Runs all Jest tests with coverage reporting.

      - name: Upload coverage report
        uses: codecov/codecov-action@v4
        with:
          files: ./backend/coverage/lcov.info
        # Optional: sends coverage % to Codecov for tracking over time.

  # ── Job 2: Security Scan ────────────────────────────────────────────────────
  security-scan:
    name: Security Vulnerability Scan
    runs-on: ubuntu-latest
    needs: test         # Only run if tests pass

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Run Trivy filesystem scan
        uses: aquasecurity/trivy-action@master
        with:
          scan-type: 'fs'
          scan-ref: './backend'
          severity: 'HIGH,CRITICAL'
          exit-code: '1'   # Fail the pipeline if HIGH/CRITICAL vulnerabilities found
        # Trivy scans your node_modules and source code for known CVEs.
        # This prevents deploying code with known security holes.

  # ── Job 3: Build & Push Docker Image ───────────────────────────────────────
  build:
    name: Build Docker Image
    runs-on: ubuntu-latest
    needs: [test, security-scan]   # Only build if tests AND security pass

    outputs:
      image_tag: ${{ steps.meta.outputs.tags }}

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3
        # Buildx enables multi-platform builds and advanced caching.

      - name: Log in to container registry
        uses: docker/login-action@v3
        with:
          registry: ${{ secrets.DOCKER_REGISTRY_URL }}
          username: ${{ secrets.DOCKER_REGISTRY_USER }}
          password: ${{ secrets.DOCKER_REGISTRY_PASSWORD }}

      - name: Extract Docker metadata (tags, labels)
        id: meta
        uses: docker/metadata-action@v5
        with:
          images: ${{ secrets.DOCKER_REGISTRY_URL }}/advantour/api
          # Automatically creates tags:
          # On push to develop: :develop-abc1234 (branch + short commit SHA)
          # On git tag v1.2.3:  :1.2.3 and :latest
          tags: |
            type=ref,event=branch
            type=semver,pattern={{version}}
            type=semver,pattern={{major}}.{{minor}}
            type=sha,prefix={{branch}}-

      - name: Build and push Docker image
        uses: docker/build-push-action@v5
        with:
          context: ./backend
          push: true
          tags: ${{ steps.meta.outputs.tags }}
          labels: ${{ steps.meta.outputs.labels }}
          cache-from: type=gha   # Use GitHub Actions cache for faster builds
          cache-to:   type=gha,mode=max

  # ── Job 4: Deploy to Development ────────────────────────────────────────────
  deploy-dev:
    name: Deploy to Development
    runs-on: ubuntu-latest
    needs: build
    if: github.ref == 'refs/heads/develop'
    environment: development    # GitHub environment (can require manual approval)

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Configure kubectl for dev cluster
        run: |
          mkdir -p ~/.kube
          echo "${{ secrets.KUBECONFIG_DEV }}" | base64 -d > ~/.kube/config
          chmod 600 ~/.kube/config
        # This decodes the base64 kubeconfig and places it where kubectl expects it.

      - name: Deploy to Kubernetes dev namespace
        run: |
          IMAGE_TAG="${{ secrets.DOCKER_REGISTRY_URL }}/advantour/api:develop-${GITHUB_SHA::7}"

          kubectl set image deployment/advantour-api \
            advantour-api=$IMAGE_TAG \
            --namespace=advantour-dev

          # Wait for the rolling update to complete (timeout 5 minutes)
          kubectl rollout status deployment/advantour-api \
            --namespace=advantour-dev \
            --timeout=300s

      - name: Verify deployment
        run: |
          kubectl get pods -n advantour-dev -l app=advantour-api
          echo "✅ Development deployment complete"

  # ── Job 5: Deploy to Staging ─────────────────────────────────────────────────
  deploy-staging:
    name: Deploy to Staging
    runs-on: ubuntu-latest
    needs: build
    if: github.ref == 'refs/heads/staging'
    environment:
      name: staging
      url: https://staging.advantour.com

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Configure kubectl for staging
        run: |
          mkdir -p ~/.kube
          echo "${{ secrets.KUBECONFIG_STAGING }}" | base64 -d > ~/.kube/config

      - name: Deploy to staging namespace
        run: |
          IMAGE_TAG="${{ secrets.DOCKER_REGISTRY_URL }}/advantour/api:staging-${GITHUB_SHA::7}"
          kubectl set image deployment/advantour-api advantour-api=$IMAGE_TAG -n advantour-staging
          kubectl rollout status deployment/advantour-api -n advantour-staging --timeout=300s

      - name: Run smoke tests against staging
        run: |
          # Wait for DNS/load balancer
          sleep 30
          # Basic API health check
          curl --fail https://staging-api.advantour.com/health || \
            (echo "❌ Staging health check FAILED" && exit 1)
          echo "✅ Staging deployment verified"

  # ── Job 6: Deploy to Production ──────────────────────────────────────────────
  deploy-production:
    name: Deploy to Production
    runs-on: ubuntu-latest
    needs: build
    if: startsWith(github.ref, 'refs/tags/v')   # Only on version tags
    environment:
      name: production
      url: https://api.advantour.com
    # NOTE: Configure "Required reviewers" in GitHub Environment settings
    # so a human must approve before production deploys.

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Configure kubectl for production
        run: |
          mkdir -p ~/.kube
          echo "${{ secrets.KUBECONFIG_PROD }}" | base64 -d > ~/.kube/config

      - name: Deploy to production namespace
        run: |
          # Use the semantic version tag as the image tag
          IMAGE_TAG="${{ secrets.DOCKER_REGISTRY_URL }}/advantour/api:${GITHUB_REF_NAME}"
          kubectl set image deployment/advantour-api advantour-api=$IMAGE_TAG -n advantour-prod
          kubectl rollout status deployment/advantour-api -n advantour-prod --timeout=300s

      - name: Post-deploy production smoke test
        run: |
          sleep 30
          curl --fail https://api.advantour.com/health || \
            (kubectl rollout undo deployment/advantour-api -n advantour-prod && exit 1)
          echo "✅ Production deployment successful — version ${GITHUB_REF_NAME}"

      - name: Create GitHub Release
        uses: softprops/action-gh-release@v1
        if: startsWith(github.ref, 'refs/tags/')
        with:
          generate_release_notes: true