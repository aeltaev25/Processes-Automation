# ─────────────────────────────────────────────────────────────────────────────
# ADVANTOUR — Kubernetes ConfigMaps
#
# ConfigMaps store NON-SECRET configuration (env vars, config files).
# Secrets store sensitive values (passwords, keys).
# The combination of both is injected into each pod as environment variables.
#
# HOW TO APPLY:
#   kubectl apply -f k8s/configmaps/
#
# HOW TO VIEW:
#   kubectl get configmap advantour-config -n advantour-prod -o yaml
# ─────────────────────────────────────────────────────────────────────────────

---
# Production ConfigMap
apiVersion: v1
kind: ConfigMap
metadata:
  name: advantour-config
  namespace: advantour-prod
data:
  NODE_ENV:        "production"
  PORT:            "4000"
  LOG_LEVEL:       "info"
  JWT_EXPIRY:      "8h"
  REFRESH_EXPIRY:  "30d"
  DB_HOST:         "postgresql-service"       # Kubernetes Service DNS name
  DB_PORT:         "5432"
  DB_NAME:         "advantour_prod"
  DB_USER:         "advantour_app"
  DB_POOL_MIN:     "5"
  DB_POOL_MAX:     "20"
  DB_SSL:          "true"
  REDIS_HOST:      "redis-service"
  REDIS_PORT:      "6379"
  CORS_ORIGINS:    "https://app.advantour.com,https://admin.advantour.com"

---
# Staging ConfigMap — same structure, different values
apiVersion: v1
kind: ConfigMap
metadata:
  name: advantour-config
  namespace: advantour-staging
data:
  NODE_ENV:        "staging"
  PORT:            "4000"
  LOG_LEVEL:       "debug"
  JWT_EXPIRY:      "8h"
  REFRESH_EXPIRY:  "30d"
  DB_HOST:         "postgresql-service"
  DB_PORT:         "5432"
  DB_NAME:         "advantour_staging"
  DB_USER:         "advantour_app"
  DB_POOL_MIN:     "2"
  DB_POOL_MAX:     "10"
  DB_SSL:          "false"
  REDIS_HOST:      "redis-service"
  REDIS_PORT:      "6379"
  CORS_ORIGINS:    "https://staging.advantour.com,http://localhost:3000"

---
# Dev ConfigMap
apiVersion: v1
kind: ConfigMap
metadata:
  name: advantour-config
  namespace: advantour-dev
data:
  NODE_ENV:        "development"
  PORT:            "4000"
  LOG_LEVEL:       "debug"
  JWT_EXPIRY:      "24h"
  DB_HOST:         "postgresql-service"
  DB_PORT:         "5432"
  DB_NAME:         "advantour_dev"
  DB_USER:         "advantour_app"
  DB_POOL_MIN:     "1"
  DB_POOL_MAX:     "5"
  DB_SSL:          "false"
  REDIS_HOST:      "redis-service"
  REDIS_PORT:      "6379"
  CORS_ORIGINS:    "http://localhost:3000,http://localhost:3001"