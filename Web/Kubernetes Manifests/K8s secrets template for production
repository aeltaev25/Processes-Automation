# ─────────────────────────────────────────────────────────────────────────────
# ADVANTOUR — Kubernetes Secrets
#
# CRITICAL: This file is a TEMPLATE only.
# NEVER commit real secret values to Git.
#
# HOW TO CREATE REAL SECRETS:
#   Method 1 — kubectl command (recommended for quick setup):
#     kubectl create secret generic advantour-secrets \
#       --namespace=advantour-prod \
#       --from-literal=JWT_SECRET="$(openssl rand -hex 64)" \
#       --from-literal=DB_PASSWORD="your_strong_password" \
#       --from-literal=REDIS_PASSWORD="your_redis_password"
#
#   Method 2 — Base64 encode and apply this file (replace placeholder values):
#     echo -n "your_value" | base64
#     kubectl apply -f this file
#
# HOW TO REFERENCE IN A DEPLOYMENT:
#   env:
#     - name: JWT_SECRET
#       valueFrom:
#         secretKeyRef:
#           name: advantour-secrets
#           key: JWT_SECRET
#
# NOTE: Kubernetes Secrets are base64-encoded, not encrypted by default.
# For production on a VPS, enable etcd encryption or use an external vault.
# ─────────────────────────────────────────────────────────────────────────────

# TEMPLATE — replace all <BASE64_ENCODE_YOUR_VALUE> placeholders
# To encode: echo -n "your_actual_value" | base64

---
apiVersion: v1
kind: Secret
metadata:
  name: advantour-secrets
  namespace: advantour-prod
type: Opaque
data:
  # echo -n "your_jwt_secret" | base64
  JWT_SECRET:      <BASE64_ENCODE_YOUR_JWT_SECRET_64_RANDOM_BYTES>
  DB_PASSWORD:     <BASE64_ENCODE_YOUR_DB_PASSWORD>
  REDIS_PASSWORD:  <BASE64_ENCODE_YOUR_REDIS_PASSWORD>
  RABBITMQ_URL:    <BASE64_ENCODE_YOUR_RABBITMQ_CONNECTION_STRING>

---
# Repeat for staging namespace (use DIFFERENT passwords per environment)
apiVersion: v1
kind: Secret
metadata:
  name: advantour-secrets
  namespace: advantour-staging
type: Opaque
data:
  JWT_SECRET:      <BASE64_ENCODE_STAGING_JWT_SECRET>
  DB_PASSWORD:     <BASE64_ENCODE_STAGING_DB_PASSWORD>
  REDIS_PASSWORD:  <BASE64_ENCODE_STAGING_REDIS_PASSWORD>
  RABBITMQ_URL:    <BASE64_ENCODE_STAGING_RABBITMQ_URL>