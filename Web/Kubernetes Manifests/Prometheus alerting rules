# ─────────────────────────────────────────────────────────────────────────────
# ADVANTOUR — Prometheus Alert Rules
#
# These rules define WHEN an alert fires.
# AlertManager (configured in helm-values.yaml) decides WHO gets notified.
#
# HOW TO APPLY:
#   kubectl apply -f monitoring/prometheus/alert-rules.yaml
#
# HOW TO TEST AN ALERT:
#   kubectl port-forward svc/kube-prometheus-stack-prometheus 9090:9090 -n monitoring
#   Open http://localhost:9090/alerts — you can see firing and pending alerts.
# ─────────────────────────────────────────────────────────────────────────────

---
apiVersion: monitoring.coreos.com/v1
kind: PrometheusRule
metadata:
  name: advantour-alerts
  namespace: monitoring
  labels:
    # This label tells Prometheus to load this rule file
    app: kube-prometheus-stack
    release: kube-prometheus-stack
spec:
  groups:

    # ── API Health Alerts ───────────────────────────────────────────────────
    - name: advantour.api
      interval: 30s
      rules:

        # Alert if API error rate > 5% for 2 minutes
        - alert: HighAPIErrorRate
          expr: |
            (
              rate(http_requests_total{namespace=~"advantour-.*", status_code=~"5.."}[5m])
              /
              rate(http_requests_total{namespace=~"advantour-.*"}[5m])
            ) > 0.05
          for: 2m
          labels:
            severity: warning
          annotations:
            summary: "High API error rate in {{ $labels.namespace }}"
            description: "{{ $value | humanizePercentage }} of requests are returning 5xx errors."

        # Alert if API response time > 2 seconds (p95) for 3 minutes
        - alert: SlowAPIResponseTime
          expr: |
            histogram_quantile(0.95,
              rate(http_request_duration_ms_bucket{namespace=~"advantour-.*"}[5m])
            ) > 2000
          for: 3m
          labels:
            severity: warning
          annotations:
            summary: "Slow API responses in {{ $labels.namespace }}"
            description: "95th percentile response time is {{ $value }}ms."

        # Alert if all API pods are down (no healthy pods)
        - alert: APIPodsDown
          expr: |
            count(kube_pod_status_ready{namespace=~"advantour-.*", condition="true"}) == 0
          for: 1m
          labels:
            severity: critical
          annotations:
            summary: "All API pods are down in {{ $labels.namespace }}!"
            description: "Zero healthy pods detected. Service is completely unavailable."

    # ── Database Alerts ─────────────────────────────────────────────────────
    - name: advantour.database
      rules:

        # Alert if DB connection pool is nearly exhausted
        - alert: DatabaseConnectionPoolHigh
          expr: |
            pg_stat_activity_count > 90
          for: 5m
          labels:
            severity: warning
          annotations:
            summary: "PostgreSQL connection count is high"
            description: "{{ $value }} active connections. Investigate slow queries or connection leaks."

        # Alert if DB replication lag > 30 seconds
        - alert: DatabaseReplicationLag
          expr: |
            pg_replication_lag > 30
          for: 2m
          labels:
            severity: critical
          annotations:
            summary: "PostgreSQL replication lag is too high"
            description: "Replica is {{ $value }} seconds behind primary."

    # ── Infrastructure Alerts ───────────────────────────────────────────────
    - name: advantour.infrastructure
      rules:

        # Alert if any node runs out of memory (< 10% free)
        - alert: NodeMemoryLow
          expr: |
            (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) < 0.10
          for: 5m
          labels:
            severity: critical
          annotations:
            summary: "Node {{ $labels.instance }} is running low on memory"
            description: "Only {{ $value | humanizePercentage }} memory available. Add RAM or move workloads."

        # Alert if node disk is almost full (< 15% free)
        - alert: NodeDiskSpaceLow
          expr: |
            (node_filesystem_avail_bytes{mountpoint="/"} / node_filesystem_size_bytes{mountpoint="/"}) < 0.15
          for: 10m
          labels:
            severity: warning
          annotations:
            summary: "Disk space low on {{ $labels.instance }}"
            description: "Only {{ $value | humanizePercentage }} disk space remaining on /."

        # Alert if node CPU is sustained high (> 85%)
        - alert: NodeCPUHigh
          expr: |
            100 - (avg by(instance) (rate(node_cpu_seconds_total{mode="idle"}[5m])) * 100) > 85
          for: 10m
          labels:
            severity: warning
          annotations:
            summary: "High CPU on node {{ $labels.instance }}"
            description: "CPU usage is {{ $value }}% for the past 10 minutes."

        # Alert if a pod has been restarting frequently (crash loop)
        - alert: PodCrashLooping
          expr: |
            rate(kube_pod_container_status_restarts_total{namespace=~"advantour-.*"}[15m]) > 0
          for: 5m
          labels:
            severity: critical
          annotations:
            summary: "Pod {{ $labels.pod }} is crash-looping in {{ $labels.namespace }}"
            description: "The pod has restarted {{ $value }} times in the last 15 minutes."

    # ── Finance Alerts (business-critical) ─────────────────────────────────
    - name: advantour.finance
      rules:

        # Alert if any ledger posting fails (this is CRITICAL — money at stake)
        - alert: LedgerPostingFailure
          expr: |
            rate(http_requests_total{
              namespace="advantour-prod",
              route="/api/v1/finance/journal",
              status_code=~"4..|5.."
            }[5m]) > 0
          for: 1m
          labels:
            severity: critical
          annotations:
            summary: "Finance ledger posting failures detected"
            description: "Failed journal entry requests detected. Investigate immediately."