# ─────────────────────────────────────────────────────────────────────────────
# ADVANTOUR — Horizontal Pod Autoscaler (HPA)
#
# Automatically adds/removes pods based on CPU usage.
# When Advantour gets a tour group booking spike in peak season,
# the API scales from 3 → 10 pods automatically, then scales back down.
#
# PREREQUISITE: metrics-server must be installed in the cluster.
#   kubectl apply -f https://github.com/kubernetes-sigs/metrics-server/releases/latest/download/components.yaml
# ─────────────────────────────────────────────────────────────────────────────

---
apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  name: advantour-api-hpa
  namespace: advantour-prod
spec:
  scaleTargetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: advantour-api
  minReplicas: 3    # Always run at least 3 pods for availability
  maxReplicas: 10   # Don't exceed 10 pods (VPS resource limit)

  metrics:
    # Scale up when average CPU across all pods exceeds 70%
    - type: Resource
      resource:
        name: cpu
        target:
          type: AverageUtilization
          averageUtilization: 70

    # Scale up when average memory exceeds 400Mi
    - type: Resource
      resource:
        name: memory
        target:
          type: AverageValue
          averageValue: "400Mi"

  behavior:
    scaleUp:
      stabilizationWindowSeconds: 60    # Wait 60s before scaling up again (prevent flapping)
      policies:
        - type: Pods
          value: 2
          periodSeconds: 60             # Add max 2 pods per minute
    scaleDown:
      stabilizationWindowSeconds: 300   # Wait 5 minutes before scaling down (prevent premature removal)
      policies:
        - type: Pods
          value: 1
          periodSeconds: 120            # Remove max 1 pod per 2 minutes

---
# ─────────────────────────────────────────────────────────────────────────────
# ADVANTOUR — Ingress (nginx)
#
# The Ingress is the "front door" to the cluster from the internet.
# Nginx routes incoming HTTPS traffic to the correct internal Service.
#
# PREREQUISITES:
#   1. Install nginx ingress controller:
#      kubectl apply -f https://raw.githubusercontent.com/kubernetes/ingress-nginx/controller-v1.10.1/deploy/static/provider/baremetal/deploy.yaml
#   2. Install cert-manager for automatic SSL certificates:
#      kubectl apply -f https://github.com/cert-manager/cert-manager/releases/download/v1.14.5/cert-manager.yaml
#   3. Configure your domain DNS A record to point to your VPS IP.
#
# HOW TRAFFIC FLOWS:
#   Internet → VPS IP:443 → nginx ingress → advantour-api-service:80 → pods:4000
# ─────────────────────────────────────────────────────────────────────────────

---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: advantour-ingress
  namespace: advantour-prod
  annotations:
    kubernetes.io/ingress.class: "nginx"

    # Automatic SSL certificate via Let's Encrypt (free)
    cert-manager.io/cluster-issuer: "letsencrypt-prod"

    # Security headers
    nginx.ingress.kubernetes.io/ssl-redirect: "true"
    nginx.ingress.kubernetes.io/force-ssl-redirect: "true"

    # Rate limiting at nginx level (first line of defense)
    nginx.ingress.kubernetes.io/limit-rps: "100"          # 100 requests/second per IP
    nginx.ingress.kubernetes.io/limit-connections: "50"

    # Body size limit
    nginx.ingress.kubernetes.io/proxy-body-size: "5m"

    # Timeouts
    nginx.ingress.kubernetes.io/proxy-read-timeout:    "60"
    nginx.ingress.kubernetes.io/proxy-connect-timeout: "10"

    # Enable CORS via nginx (backup to app-level CORS)
    nginx.ingress.kubernetes.io/enable-cors: "true"
    nginx.ingress.kubernetes.io/cors-allow-origin: "https://app.advantour.com,https://admin.advantour.com"

spec:
  tls:
    - hosts:
        - api.advantour.com
      secretName: advantour-api-tls   # cert-manager creates this Secret automatically

  rules:
    - host: api.advantour.com
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: advantour-api-service
                port:
                  number: 80