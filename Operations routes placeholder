// POST /api/v1/operations/tours/:tourId/documents — generate itinerary or invoice documents
router.post('/tours/:tourId/documents', authenticate, authorize('admin', 'manager', 'finance'), async (req, res, next) => {
  try {
    const { tourId } = req.params;
    const { type } = req.body;
    const supported = ['itinerary', 'invoice'];

    if (!supported.includes(type)) {
      throw new AppError('Document type must be itinerary or invoice', 400);
    }

    const tourResult = await query(`SELECT * FROM tours WHERE tour_id = $1`, [tourId]);
    const tour = tourResult.rows[0];
    if (!tour) {
      throw new AppError('Tour not found', 404);
    }

    const bookings = (await query(`SELECT * FROM tour_bookings WHERE tour_id = $1 ORDER BY created_at ASC`, [tourId])).rows;
    if (bookings.length === 0 && type === 'itinerary') {
      throw new AppError('Cannot generate itinerary without bookings in place', 422);
    }

    let document;
    if (type === 'itinerary') {
      document = await documentService.createItineraryDocumentRecord(tour, bookings, req.user.userId);
    } else {
      const lines = bookings.map((booking, index) => ({
        description: `${booking.service_type} reservation`,
        quantity: booking.pax_count || 1,
        amount: booking.cost || 0,
        currency: booking.currency || 'USD',
        line_number: index + 1,
      }));

      const invoice = {
        invoice_number: `INV-${new Date().toISOString().slice(0, 10).replace(/-/g, '')}-${Math.floor(Math.random() * 10000)}`,
        tour_id: tourId,
        created_by: req.user.userId,
        issued_at: new Date().toISOString(),
        due_date: new Date(Date.now() + 7 * 24 * 60 * 60 * 1000).toISOString(),
        currency: bookings.length > 0 ? bookings[0].currency : 'USD',
      };

      document = await documentService.createInvoiceDocumentRecord(tourId, invoice, lines, req.user.userId);
    }

    await publishEvent('tour.document.generated', {
      tour_id: tourId,
      document_id: document.document_id,
      type,
      created_by: req.user.userId,
    });

    res.status(201).json(document);
  } catch (err) {
    next(err);
  }
});

