// POST /api/v1/operations/tours/:tourId/handoff — create a cross-team handoff entry
router.post('/tours/:tourId/handoff', authenticate, authorize('admin', 'manager'), async (req, res, next) => {
  try {
    const { tourId } = req.params;
    const { from_team, to_team, notes, next_status } = req.body;

    if (!from_team || !to_team) {
      throw new AppError('from_team and to_team are required for handoff', 400);
    }

    const result = await query(
      `INSERT INTO tour_handoffs (tour_id, from_team, to_team, notes, status, created_by)
       VALUES ($1, $2, $3, $4, $5, $6)
       RETURNING *`,
      [tourId, from_team, to_team, notes || '', 'pending', req.user.userId]
    );

    if (next_status) {
      await query(`UPDATE tours SET status = $1, updated_at = NOW() WHERE tour_id = $2`, [next_status, tourId]);
    }

    await publishEvent('tour.handoff.created', {
      tour_id: tourId,
      from_team,
      to_team,
      handoff_id: result.rows[0].handoff_id,
    });

    res.status(201).json(result.rows[0]);
  } catch (err) {
    next(err);
  }
});

