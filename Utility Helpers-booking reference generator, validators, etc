# ─────────────────────────────────────────────────────────────────────────────
# BOOKING REFERENCE GENERATOR
# ─────────────────────────────────────────────────────────────────────────────

def generate_booking_ref(db_session) -> str:
    """
    Generate a unique, human-readable booking reference: TB-YYYY-NNNN
    Uses the current highest id to avoid DB round-trips in most cases.
    """
    from models import TourBooking
    year  = datetime.utcnow().year
    count = db_session.query(TourBooking).count() + 1
    return f"TB-{year}-{count:04d}"


