{
  "name": "advantour-api",
  "version": "1.0.0",
  "description": "Advantour Tour Company — Backend API Server",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start":       "node src/server.js",
    "dev":         "nodemon src/server.js",
    "test":        "jest --runInBand --forceExit",
    "test:watch":  "jest --watch",
    "test:cover":  "jest --coverage",
    "lint":        "eslint src/ --ext .js",
    "lint:fix":    "eslint src/ --ext .js --fix",
    "db:migrate":  "node-pg-migrate up",
    "db:rollback": "node-pg-migrate down"
  },
  "dependencies": {
    "amqplib":           "^0.10.4",
    "bcryptjs":          "^2.4.3",
    "compression":       "^1.7.4",
    "cors":              "^2.8.5",
    "dotenv":            "^16.4.5",
    "express":           "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet":            "^7.1.0",
    "joi":               "^17.13.1",
    "jsonwebtoken":      "^9.0.2",
    "morgan":            "^1.10.0",
    "pg":                "^8.12.0",
    "prom-client":       "^15.1.3",
    "redis":             "^4.6.14",
    "uuid":              "^10.0.0",
    "winston":           "^3.13.0"
  },
  "devDependencies": {
    "eslint":            "^8.57.0",
    "jest":              "^29.7.0",
    "nodemon":           "^3.1.4",
    "supertest":         "^7.0.0"
  }
}