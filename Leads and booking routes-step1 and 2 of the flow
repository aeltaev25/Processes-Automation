@bp.route("/bookings", methods=["GET"])
def list_bookings():
    status  = request.args.get("status")
    query   = TourBooking.query.order_by(TourBooking.arrival_date.asc())
    if status:
        query = query.filter(TourBooking.status == status)
    page     = int(request.args.get("page", 1))
    per_page = int(request.args.get("per_page", 25))
    return success_response(data=paginate(query, page, per_page))


@bp.route("/bookings/<int:booking_id>", methods=["GET"])
def get_booking(booking_id):
    """
    Full booking dashboard — returns the booking plus all linked departments.
    """
    b = TourBooking.query.get_or_404(booking_id)
    data = b.to_dict()
    data["hotel_requests"]        = [r.to_dict() for r in b.hotel_requests]
    data["restaurant_requests"]   = [r.to_dict() for r in b.restaurant_requests]
    data["transport_assignments"]  = [r.to_dict() for r in b.transport_assignments]
    data["guide_assignments"]     = [r.to_dict() for r in b.guide_assignments]
    data["railway_tickets"]       = [r.to_dict() for r in b.railway_tickets]
    data["aviation_tickets"]      = [r.to_dict() for r in b.aviation_tickets]
    data["accounting"]            = b.accounting.to_dict() if b.accounting else None
    return success_response(data=data)


@bp.route("/bookings/<int:booking_id>/status", methods=["PATCH"])
def update_booking_status(booking_id):
    booking = TourBooking.query.get_or_404(booking_id)
    data    = request.get_json(silent=True) or {}
    old     = booking.status
    new_status = data.get("status")
    if new_status:
        booking.status = new_status
        if new_status == BookingStatus.IN_PROGRESS:
            booking.to_confirmation_sent_at = booking.to_confirmation_sent_at or datetime.utcnow()
    AuditLog.log("tour_booking", booking.id, "status_changed",
                 old_value=old, new_value=booking.status,
                 performed_by=data.get("performed_by", "staff"))
    db.session.commit()
    return success_response(data=booking.to_dict(), message="Booking status updated.")


@bp.route("/bookings/<int:booking_id>/services-rendered", methods=["POST"])
def mark_services_rendered(booking_id):
    """
    Mark that the tour has ended and all services have been delivered.
    Triggers the invoice collection / final accounting phase.
    """
    booking = TourBooking.query.get_or_404(booking_id)
    data    = request.get_json(silent=True) or {}

    booking.services_rendered = True
    booking.status            = BookingStatus.COMPLETED

    AuditLog.log("tour_booking", booking.id, "services_rendered",
                 performed_by=data.get("performed_by", "staff"))
    db.session.commit()
    logger.info(f"[Booking] {booking.booking_ref} — services marked as rendered.")
    return success_response(message="Services marked as rendered. Invoice collection phase begins.")