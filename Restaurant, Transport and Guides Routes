"""
routes/operations.py
─────────────────────
Covers three parallel operational departments:

  A) RESTAURANTS
     POST /api/bookings/<id>/restaurant-requests  → send request
     PATCH /api/restaurant-requests/<id>/reply    → confirmed / alternative
     PATCH /api/restaurant-requests/<id>/act      → post-meal invoice

  B) TRANSPORT  (Car 4 Tours + Transfers)
     GET  /api/drivers                            → driver roster
     POST /api/drivers                            → add driver
     POST /api/bookings/<id>/transport            → create transport assignment
     PATCH /api/transport/<id>/assign-driver      → assign a driver
     POST /api/transport/<id>/send-program        → send program to driver
     PATCH /api/transport/<id>/complete           → mark service done + log cost
     POST /api/transport/monthly-reconcile        → end-of-month driver payments

  C) GUIDES
     GET  /api/guides                             → guide roster
     POST /api/guides                             → add guide
     POST /api/bookings/<id>/guides               → create guide assignment
     PATCH /api/guide-assignments/<id>/request    → send request (orange)
     PATCH /api/guide-assignments/<id>/reply      → guide confirmed / busy
     POST /api/guide-assignments/<id>/send-info   → day-before info to guide
     PATCH /api/guide-assignments/<id>/payment    → log guide payment
     POST /api/guides/monthly-collect             → end-of-month payment collection
"""

