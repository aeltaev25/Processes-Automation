@bp.route("/guide-assignments/<int:ga_id>/payment", methods=["PATCH"])
def log_guide_payment(ga_id):
    """
    Log guide payment in Guides Charges sheet and update accounting.
    """
    ga   = GuideAssignment.query.get_or_404(ga_id)
    data = request.get_json(silent=True) or {}

    ga.fee             = data.get("fee", ga.fee)
    ga.payment_logged  = True

    # Push cost to accounting
    accounting = ga.booking.accounting
    if accounting and ga.fee:
        current_cost = float(accounting.guide_cost or 0)
        accounting.guide_cost = current_cost + float(ga.fee)
        accounting.recalculate()

    AuditLog.log("guide_assignment", ga.id, "payment_logged",
                 new_value=str(ga.fee), performed_by=data.get("performed_by", "staff"))

    # Create invoice for accounting
    if accounting:
        inv = Invoice(
            accounting_id = accounting.id,
            supplier_type = "guide",
            supplier_name = ga.guide.full_name if ga.guide else "Unknown Guide",
            amount        = ga.fee,
            status        = InvoiceStatus.PRICE_OK,
        )
        db.session.add(inv)

    db.session.commit()

    try:
        NotificationService.guide_payment_confirmation(ga.booking, ga)
    except Exception as exc:
        logger.warning(f"[Guide] Payment confirmation TG failed: {exc}")

    ga.cc_accounting_confirmed = True
    db.session.commit()
    return success_response(data=ga.to_dict(), message="Guide payment logged to accounting. ✅")


@bp.route("/guides/monthly-collect", methods=["POST"])
def monthly_collect_guides():
    """
    End-of-month: collect all unpaid guide fees and report total.
    """
    unpaid = (
        GuideAssignment.query
        .filter_by(status=GuideStatus.CONFIRMED, monthly_collected=False, payment_logged=True)
        .all()
    )
    total = sum(float(ga.fee or 0) for ga in unpaid)
    for ga in unpaid:
        ga.monthly_collected = True
    db.session.commit()
    return success_response(
        data={
            "collected_count": len(unpaid),
            "total_fees":      total,
            "month":           datetime.utcnow().strftime("%Y-%m"),
        },
        message=f"{len(unpaid)} guide payments collected this month."
    )