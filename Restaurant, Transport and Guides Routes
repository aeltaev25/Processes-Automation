def create_transport(booking_id):
    """Create a transport need (car for tour or transfer)."""
    booking = TourBooking.query.get_or_404(booking_id)
    data    = request.get_json()
    svc_date = validate_date(data.get("service_date"))
    if not svc_date:
        return error_response("service_date must be a valid date.", 422)

    ta = TransportAssignment(
        booking_id       = booking.id,
        transport_type   = data["transport_type"],   # tour_car / transfer
        service_date     = svc_date,
        service_time     = data.get("service_time", "09:00"),
        pickup_location  = data.get("pickup_location", "").strip() or None,
        dropoff_location = data.get("dropoff_location", "").strip() or None,
        geo_link         = data.get("geo_link"),
        route_notes      = data.get("route_notes"),
        pax              = int(data.get("pax", booking.pax)),
        car_type_needed  = data.get("car_type_needed"),
        price            = data.get("price"),
        status           = TransportStatus.PLANNED,
        notes            = data.get("notes"),
    )
    db.session.add(ta)
    db.session.flush()
    AuditLog.log("transport_assignment", ta.id, "created",
                 new_value=TransportStatus.PLANNED,
                 performed_by=data.get("created_by", "staff"))
    db.session.commit()
    return success_response(data=ta.to_dict(), status_code=201,
                            message="Transport assignment created.")


@bp.route("/transport/<int:ta_id>/assign-driver", methods=["PATCH"])
@require_json("driver_id")
def assign_driver(ta_id):
    """
    Assign a specific driver to a transport assignment.
    Should be done 1-2 weeks before the service date.
    """
    ta   = TransportAssignment.query.get_or_404(ta_id)
    data = request.get_json()

    driver = Driver.query.get(data["driver_id"])
    if not driver:
        return error_response("Driver not found.", 404)
    if not driver.is_active:
        return error_response("Driver is not active.", 422)

    ta.driver_id    = driver.id
    ta.status       = TransportStatus.ASSIGNED
    ta.assigned_at  = datetime.utcnow()
    ta.driver_fee   = data.get("driver_fee", ta.driver_fee)

    AuditLog.log("transport_assignment", ta.id, "driver_assigned",
                 new_value=f"driver_id={driver.id} ({driver.full_name})",
                 performed_by=data.get("performed_by", "staff"))
    db.session.commit()

    try:
        NotificationService.driver_assigned(ta.booking, ta)
    except Exception as exc:
        logger.warning(f"[Transport] Driver assigned notification failed: {exc}")

    return success_response(data=ta.to_dict(), message=f"Driver {driver.full_name} assigned. ✅")


@bp.route("/transport/<int:ta_id>/send-program", methods=["POST"])
def send_driver_program(ta_id):
    """Send the full geo/program to the driver via Telegram."""
    ta   = TransportAssignment.query.get_or_404(ta_id)
    data = request.get_json(silent=True) or {}

    if not ta.driver_id:
        return error_response("No driver assigned yet.", 409)

    # Allow updating geo_link / route_notes before sending
    if "geo_link" in data:
        ta.geo_link = data["geo_link"]
    if "route_notes" in data:
        ta.route_notes = data["route_notes"]

    sent = NotificationService.driver_program_sent(ta.booking, ta)
    if not sent:
        return error_response("Failed to send program — check driver Telegram ID.", 500)

    ta.program_sent_at = datetime.utcnow()
    AuditLog.log("transport_assignment", ta.id, "program_sent",
                 performed_by=data.get("performed_by", "staff"))
    db.session.commit()
    return success_response(message="Program sent to driver via Telegram. ✅")


@bp.route("/transport/<int:ta_id>/complete", methods=["PATCH"])
def complete_transport(ta_id):
    """Mark transport service as done and log the driver fee to accounting."""
    ta   = TransportAssignment.query.get_or_404(ta_id)
    data = request.get_json(silent=True) or {}

    ta.status      = TransportStatus.COMPLETED
    ta.driver_fee  = data.get("driver_fee", ta.driver_fee)

    # Push cost to accounting
    accounting = ta.booking.accounting
    if accounting and ta.driver_fee:
        current_cost = float(accounting.transport_cost or 0)
        accounting.transport_cost = current_cost + float(ta.driver_fee)
        accounting.recalculate()

    AuditLog.log("transport_assignment", ta.id, "completed",
                 performed_by=data.get("performed_by", "staff"))
    db.session.commit()
    return success_response(data=ta.to_dict(), message="Transport marked as completed.")


@bp.route("/transport/<int:ta_id>/pay-driver", methods=["POST"])
