@bp.route("/guide-assignments/<int:ga_id>/request", methods=["PATCH"])
@require_json("guide_id")
def request_guide(ga_id):
    """
    Send a request to a specific guide → Guide Sheet turns ORANGE.
    """
    ga   = GuideAssignment.query.get_or_404(ga_id)
    data = request.get_json()

    guide = Guide.query.get(data["guide_id"])
    if not guide:
        return error_response("Guide not found.", 404)

    # Check for scheduling conflict: same guide, same date, overlapping
    conflict = (
        GuideAssignment.query
        .filter(
            GuideAssignment.guide_id     == guide.id,
            GuideAssignment.service_date == ga.service_date,
            GuideAssignment.status       == GuideStatus.CONFIRMED,
            GuideAssignment.id           != ga.id,
        )
        .first()
    )
    if conflict:
        return error_response(
            f"Guide {guide.full_name} is already confirmed for another booking "
            f"on {ga.service_date}.", 409
        )

    ga.guide_id       = guide.id
    ga.status         = GuideStatus.REQUESTED
    ga.sheet_color    = "orange"
    ga.request_sent_at= datetime.utcnow()
    ga.attempt_count  = (ga.attempt_count or 0) + 1

    AuditLog.log("guide_assignment", ga.id, "requested",
                 old_value="unassigned", new_value=f"requested → {guide.full_name}",
                 performed_by=data.get("performed_by", "staff"))
    db.session.commit()

    try:
        NotificationService.guide_requested(ga.booking, ga)
    except Exception as exc:
        logger.warning(f"[Guide] Request TG notification failed: {exc}")

    return success_response(data=ga.to_dict(),
                            message=f"Request sent to {guide.full_name} (orange). ✅")


@bp.route("/guide-assignments/<int:ga_id>/reply", methods=["PATCH"])
@require_json("reply")
def record_guide_reply(ga_id):
    """
    Record guide's reply: 'confirmed' or 'busy'.
    • confirmed → sheet turns GREEN, tour leader check triggered.
    • busy      → status = FINDING_ALT, staff must request another guide.
    """
    ga   = GuideAssignment.query.get_or_404(ga_id)
    data = request.get_json()
    reply = data.get("reply", "").lower()

    if reply not in ("confirmed", "busy"):
        return error_response("reply must be 'confirmed' or 'busy'.", 422)

    if reply == "confirmed":
        ga.status        = GuideStatus.CONFIRMED
        ga.sheet_color   = "green"
        ga.confirmed_at  = datetime.utcnow()
        ga.fee           = data.get("fee", ga.fee)
        AuditLog.log("guide_assignment", ga.id, "confirmed",
                     new_value=f"green → {ga.guide.full_name if ga.guide else '—'}")
        db.session.commit()
        return success_response(data=ga.to_dict(),
                                message="Guide confirmed ✅ (green). Check tour leader next.")
    else:
        old_guide = ga.guide.full_name if ga.guide else "—"
        ga.guide_id    = None
        ga.status      = GuideStatus.FINDING_ALT
        ga.sheet_color = "red"
        AuditLog.log("guide_assignment", ga.id, "guide_busy",
                     old_value=old_guide, new_value="finding_alternative")
        db.session.commit()
        return success_response(data=ga.to_dict(),
                                message="Guide busy — please request another guide.")


