@bp.route("/transport/monthly-reconcile", methods=["POST"])
def monthly_reconcile_transport():
    """
    End-of-month: mark all completed, unpaid transport assignments as reconciled.
    Returns a summary for accounting.
    """
    unreconciled = (
        TransportAssignment.query
        .filter_by(status=TransportStatus.COMPLETED, monthly_reconciled=False)
        .all()
    )
    total_amount = sum(float(ta.driver_fee or 0) for ta in unreconciled)
    for ta in unreconciled:
        ta.monthly_reconciled = True
    db.session.commit()

    return success_response(
        data={
            "reconciled_count":  len(unreconciled),
            "total_driver_fees": total_amount,
            "month":             datetime.utcnow().strftime("%Y-%m"),
        },
        message=f"{len(unreconciled)} transport assignments reconciled for the month."
    )


