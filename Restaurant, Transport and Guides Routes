@bp.route("/bookings/<int:booking_id>/restaurant-requests", methods=["POST"])
@require_json("meal_type", "meal_date", "pax")
def create_restaurant_request(booking_id):
    """
    Book a restaurant for a meal.
    If restaurant_id is not provided, the field is left blank and staff will fill it.
    """
    booking = TourBooking.query.get_or_404(booking_id)
    data    = request.get_json()
    meal_date = validate_date(data.get("meal_date"))
    if not meal_date:
        return error_response("meal_date must be a valid date (YYYY-MM-DD).", 422)

    rest = None
    if data.get("restaurant_id"):
        rest = Restaurant.query.get(data["restaurant_id"])

    rr = RestaurantRequest(
        booking_id       = booking.id,
        restaurant_id    = rest.id if rest else None,
        restaurant_name  = (rest.name if rest else data.get("restaurant_name", "TBD")).strip(),
        meal_type        = data["meal_type"].lower(),    # lunch / dinner
        meal_date        = meal_date,
        meal_time        = data.get("meal_time", "13:00"),
        pax              = int(data["pax"]),
        menu_details     = data.get("menu_details"),
        dietary_notes    = data.get("dietary_notes"),
        request_sent_via = data.get("request_sent_via", "telegram"),
        request_sent_at  = datetime.utcnow(),
        price_agreed     = data.get("price_agreed"),
        status           = RestaurantStatus.PENDING,
        notes            = data.get("notes"),
    )
    db.session.add(rr)
    db.session.flush()
    AuditLog.log("restaurant_request", rr.id, "created",
                 new_value=RestaurantStatus.PENDING,
                 performed_by=data.get("created_by", "staff"))
    db.session.commit()

    try:
        NotificationService.restaurant_request_sent(booking, rr)
    except Exception as exc:
        logger.warning(f"[Restaurant] TG notification failed: {exc}")

    return success_response(data=rr.to_dict(), status_code=201,
                            message="Restaurant request created.")


@bp.route("/restaurant-requests/<int:req_id>/reply", methods=["PATCH"])
@require_json("reply")
def record_restaurant_reply(req_id):
    """
    Record restaurant reply: 'confirmed' or 'full'.
    If full → mark as alternative needed, notify team.
    """
    rr   = RestaurantRequest.query.get_or_404(req_id)
    data = request.get_json()
    reply = data.get("reply", "").lower()

    if reply not in ("confirmed", "full"):
        return error_response("reply must be 'confirmed' or 'full'.", 422)

    rr.reply_received_at = datetime.utcnow()

    if reply == "confirmed":
        rr.status        = RestaurantStatus.CONFIRMED
        rr.excel_row_ref = data.get("excel_row_ref")
        AuditLog.log("restaurant_request", rr.id, "confirmed",
                     performed_by=data.get("performed_by", "staff"))
        db.session.commit()
        return success_response(data=rr.to_dict(), message="Restaurant confirmed ✅")
    else:
        rr.status       = RestaurantStatus.ALTERNATIVE
        rr.is_alternative = True
        AuditLog.log("restaurant_request", rr.id, "full_need_alternative",
                     performed_by=data.get("performed_by", "staff"))
        db.session.commit()
        try:
            NotificationService.restaurant_alternative(rr.booking, rr)
        except Exception as exc:
            logger.warning(f"[Restaurant] Alternative notification failed: {exc}")
        return success_response(data=rr.to_dict(),
                                message="Restaurant full — please book an alternative venue.")


@bp.route("/restaurant-requests/<int:req_id>/act", methods=["PATCH"])
def record_restaurant_act(req_id):
    """Post-meal act + price verification."""
    rr   = RestaurantRequest.query.get_or_404(req_id)
    data = request.get_json(silent=True) or {}
    rr.act_received   = True
    rr.act_amount     = data.get("act_amount")
    rr.price_verified = bool(data.get("price_verified", False))

    accounting = rr.booking.accounting
    if accounting and rr.act_amount:
        accounting.restaurant_cost = float(rr.act_amount)
        accounting.recalculate()

    AuditLog.log("restaurant_request", rr.id, "act_recorded",
                 new_value=str(rr.act_amount), performed_by=data.get("performed_by", "staff"))
    db.session.commit()
    return success_response(data=rr.to_dict(), message="Restaurant act recorded.")


