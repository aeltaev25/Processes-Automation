               margin:auto;padding:20px;border:1px solid #e5e7eb;border-radius:8px">
          <div style="background:{cls.BRAND_COLOR};padding:16px;border-radius:6px 6px 0 0">
            <h2 style="color:#fff;margin:0">{company}</h2>
          </div>
          <div style="padding:20px">
            <h3>{title}</h3>
            {body_html}
          </div>
          <div style="background:#f1f5f9;padding:10px;font-size:11px;color:#6b7280;
               border-radius:0 0 6px 6px;text-align:center">
