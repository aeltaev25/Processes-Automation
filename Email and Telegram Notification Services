          <tr><td style="padding:6px;background:#f8fafc;width:35%"><b>Destination</b></td>
              <td style="padding:6px">{lead.destination or '—'}</td></tr>
          <tr><td style="padding:6px;background:#f8fafc"><b>Arrival</b></td>
              <td style="padding:6px">{lead.arrival_date or '—'}</td></tr>
          <tr><td style="padding:6px;background:#f8fafc"><b>Departure</b></td>
              <td style="padding:6px">{lead.departure_date or '—'}</td></tr>
          <tr><td style="padding:6px;background:#f8fafc"><b>Pax</b></td>
              <td style="padding:6px">{lead.pax}</td></tr>
