    flight_number   = db.Column(db.String(30))
    route_from      = db.Column(db.String(100))
    route_to        = db.Column(db.String(100))
    departure_datetime = db.Column(db.DateTime)
    arrival_datetime   = db.Column(db.DateTime)
    seat_class      = db.Column(db.String(50))
    # Purchase / booking workflow
    status          = db.Column(db.String(50), default=TicketStatus.NOT_PURCHASED)
    on_waitlist     = db.Column(db.Boolean, default=False)
    waitlist_position = db.Column(db.Integer)
    # 45-day check
    checked_at_45_days = db.Column(db.Boolean, default=False)
    check_45_days_at   = db.Column(db.DateTime)
    # Issuance
    pnr             = db.Column(db.String(20))    # booking locator
    ticket_number   = db.Column(db.String(50))
    ticket_file     = db.Column(db.String(500))
    sent_to_client  = db.Column(db.Boolean, default=False)
    sent_to_client_at = db.Column(db.DateTime)
    # Accounting
    price           = db.Column(db.Numeric(10, 2))
    tax             = db.Column(db.Numeric(10, 2))
    act_aviation_kassа = db.Column(db.Boolean, default=False)   # act from aviation kassa received
    act_reconciled  = db.Column(db.Boolean, default=False)
    notes           = db.Column(db.Text)
    created_at      = db.Column(db.DateTime, default=datetime.utcnow)
