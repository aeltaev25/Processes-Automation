# 3. HOTEL REQUEST
# ─────────────────────────────────────────────────────────────────────────────

class Hotel(db.Model):
    """Master list of hotels (supplier catalogue)."""
    __tablename__ = "hotels"

    id           = db.Column(db.Integer, primary_key=True)
    name         = db.Column(db.String(255), nullable=False)
    city         = db.Column(db.String(100))
    stars        = db.Column(db.Integer)
    contact_email= db.Column(db.String(255))
    contact_phone= db.Column(db.String(50))
    telegram_contact = db.Column(db.String(100))
    is_active    = db.Column(db.Boolean, default=True)
    created_at   = db.Column(db.DateTime, default=datetime.utcnow)

    requests     = db.relationship("HotelRequest", back_populates="hotel")

    def to_dict(self):
        return {c.name: getattr(self, c.name) for c in self.__table__.columns}


class HotelRequest(db.Model):
    """
    One booking may have multiple hotel requests if the first hotel
    replies 'no rooms' and we move to the next one.
    """
    __tablename__ = "hotel_requests"

    id            = db.Column(db.Integer, primary_key=True)
    booking_id    = db.Column(db.Integer, db.ForeignKey("tour_bookings.id"), nullable=False)
    hotel_id      = db.Column(db.Integer, db.ForeignKey("hotels.id"), nullable=True)
    attempt_number= db.Column(db.Integer, default=1)    # 1st hotel, 2nd hotel, etc.
    hotel_name    = db.Column(db.String(255))           # denormalized for speed
    room_type     = db.Column(db.String(100))
    check_in      = db.Column(db.Date)
    check_out     = db.Column(db.Date)
    num_rooms     = db.Column(db.Integer, default=1)
    price_per_night = db.Column(db.Numeric(10, 2))
    total_price   = db.Column(db.Numeric(10, 2))
    # Communication
    request_sent_via = db.Column(db.String(50))         # email / telegram
    request_sent_at  = db.Column(db.DateTime)
    reply_received_at= db.Column(db.DateTime)
    confirmation_code= db.Column(db.String(100))
    # Workflow
    status        = db.Column(db.String(50), default=HotelRequestStatus.PENDING)
    # 45-day confirmation
    confirm_sent_at = db.Column(db.DateTime)
    # Post-stay
    act_received  = db.Column(db.Boolean, default=False)
    act_received_at = db.Column(db.DateTime)
    act_amount    = db.Column(db.Numeric(10, 2))
    price_verified= db.Column(db.Boolean, default=False)
    notes         = db.Column(db.Text)
    created_at    = db.Column(db.DateTime, default=datetime.utcnow)
    updated_at    = db.Column(db.DateTime, default=datetime.utcnow, onupdate=datetime.utcnow)

    booking       = db.relationship("TourBooking",  back_populates="hotel_requests")
    hotel         = db.relationship("Hotel",        back_populates="requests")

    def to_dict(self):
        d = {c.name: getattr(self, c.name) for c in self.__table__.columns}
        for key in ("price_per_night", "total_price", "act_amount"):
            if d.get(key) is not None:
                d[key] = float(d[key])
        return d


