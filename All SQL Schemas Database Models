class Guide(db.Model):
    __tablename__ = "guides"

    id            = db.Column(db.Integer, primary_key=True)
    full_name     = db.Column(db.String(150), nullable=False)
    phone         = db.Column(db.String(50))
    telegram_id   = db.Column(db.String(100))
    languages     = db.Column(db.String(200))   # comma-separated: "en,ru,fr"
    cities        = db.Column(db.String(200))   # cities where guide operates
    license_number= db.Column(db.String(100))
    is_active     = db.Column(db.Boolean, default=True)
    created_at    = db.Column(db.DateTime, default=datetime.utcnow)

    assignments   = db.relationship("GuideAssignment", back_populates="guide")

    def to_dict(self):
        return {c.name: getattr(self, c.name) for c in self.__table__.columns}


class GuideAssignment(db.Model):
    """
    Tracks the Guide Sheet workflow:
    Red (unassigned) → Orange (requested) → Green (confirmed)
    Blue = tour cancelled.
    """
    __tablename__ = "guide_assignments"

    id              = db.Column(db.Integer, primary_key=True)
    booking_id      = db.Column(db.Integer, db.ForeignKey("tour_bookings.id"), nullable=False)
    guide_id        = db.Column(db.Integer, db.ForeignKey("guides.id"), nullable=True)
    # Service details
    city            = db.Column(db.String(100))
    language        = db.Column(db.String(50))
    service_date    = db.Column(db.Date)
    service_time    = db.Column(db.String(20))
    duration_hours  = db.Column(db.Float)
    pax             = db.Column(db.Integer)
    tour_program    = db.Column(db.Text)   # what sites the guide will cover
    # Guide Sheet color / status
    sheet_color     = db.Column(db.String(20), default="red")    # red/orange/green/blue
    status          = db.Column(db.String(50), default=GuideStatus.UNASSIGNED)
    attempt_count   = db.Column(db.Integer, default=0)   # how many guides tried
    # Communication timestamps
    request_sent_at = db.Column(db.DateTime)
    confirmed_at    = db.Column(db.DateTime)
    info_sent_via_tg= db.Column(db.Boolean, default=False)  # day-before/friday info sent
    info_sent_at    = db.Column(db.DateTime)
    # Tour leader check
    tour_leader_checked  = db.Column(db.Boolean, default=False)
    tour_leader_check_at = db.Column(db.DateTime)
    # Accounting
    fee             = db.Column(db.Numeric(10, 2))
    payment_logged  = db.Column(db.Boolean, default=False)   # in Guides Charges sheet
    monthly_collected = db.Column(db.Boolean, default=False)
    cc_accounting_confirmed = db.Column(db.Boolean, default=False)
    notes           = db.Column(db.Text)
    created_at      = db.Column(db.DateTime, default=datetime.utcnow)
    updated_at      = db.Column(db.DateTime, default=datetime.utcnow, onupdate=datetime.utcnow)

    booking         = db.relationship("TourBooking", back_populates="guide_assignments")
    guide           = db.relationship("Guide",       back_populates="assignments")

    def to_dict(self):
        d = {c.name: getattr(self, c.name) for c in self.__table__.columns}
        if d.get("fee") is not None:
            d["fee"] = float(d["fee"])
        return d


