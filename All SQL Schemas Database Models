"""
models.py — SQLAlchemy ORM models for the full tour-operator CRM.

Entity relationships (high-level):
    Lead  ──1:1──►  TourBooking
    TourBooking  ──1:N──►  HotelRequest
    TourBooking  ──1:N──►  RestaurantRequest
    TourBooking  ──1:N──►  TransportAssignment
    TourBooking  ──1:N──►  GuideAssignment
    TourBooking  ──1:N──►  RailwayTicket
    TourBooking  ──1:N──►  AviationTicket
    TourBooking  ──1:1──►  AccountingRecord
    AccountingRecord ──1:N──►  Invoice
"""

from datetime import datetime
from flask_sqlalchemy import SQLAlchemy

db = SQLAlchemy()

# ─────────────────────────────────────────────────────────────────────────────
# ENUMERATIONS  (stored as plain strings for SQLite compatibility)
# ─────────────────────────────────────────────────────────────────────────────

class LeadStatus:
    NEW         = "new"
    IN_PROGRESS = "in_progress"
    CONVERTED   = "converted"
    LOST        = "lost"

class BookingStatus:
    DRAFT       = "draft"
    CONFIRMED   = "confirmed"
    IN_PROGRESS = "in_progress"   # tour is happening right now
    COMPLETED   = "completed"
    CANCELLED   = "cancelled"

class HotelRequestStatus:
    PENDING     = "pending"       # waiting for hotel reply
    BOOKED      = "booked"
    NO_ROOMS    = "no_rooms"      # trying next hotel
    CANCELLED   = "cancelled"

class RestaurantStatus:
    PENDING     = "pending"
    CONFIRMED   = "confirmed"
    ALTERNATIVE = "alternative"   # moved to different venue
    CANCELLED   = "cancelled"

class TransportStatus:
    PLANNED     = "planned"
    ASSIGNED    = "assigned"      # driver assigned
    REMINDED    = "reminded"      # 1-day reminder sent
    COMPLETED   = "completed"
    CANCELLED   = "cancelled"

class GuideStatus:
    UNASSIGNED  = "unassigned"    # red in Guide Sheet
    REQUESTED   = "requested"     # orange
    CONFIRMED   = "confirmed"     # green
    CANCELLED   = "cancelled"     # blue
    FINDING_ALT = "finding_alt"   # guide was busy, looking for another

class TicketStatus:
    NOT_PURCHASED = "not_purchased"
    WAITLISTED    = "waitlisted"
    PURCHASED     = "purchased"
    SENT_TO_CLIENT= "sent_to_client"
    CANCELLED     = "cancelled"

class InvoiceStatus:
    PENDING       = "pending"
    PRICE_OK      = "price_ok"
    PRICE_DISPUTE = "price_dispute"
    PAID          = "paid"

class PaymentStatus:
    UNPAID        = "unpaid"
    PARTIAL       = "partial"
    PAID          = "paid"
    OVERPAID      = "overpaid"


# ─────────────────────────────────────────────────────────────────────────────
# 1. LEAD  — initial website / phone enquiry
# ─────────────────────────────────────────────────────────────────────────────

class Lead(db.Model):
    __tablename__ = "leads"

    id            = db.Column(db.Integer,  primary_key=True)
    # Contact info
    name          = db.Column(db.String(150), nullable=False)
    email         = db.Column(db.String(255), nullable=False)
    phone         = db.Column(db.String(50))
    country       = db.Column(db.String(100))
    language      = db.Column(db.String(50))   # needed for guide assignment
    # Tour request details
    tour_type     = db.Column(db.String(100))  # group, individual, corporate, etc.
    destination   = db.Column(db.String(255))
    pax           = db.Column(db.Integer, default=1)  # number of people
    arrival_date  = db.Column(db.Date)
    departure_date= db.Column(db.Date)
    message       = db.Column(db.Text)
    source        = db.Column(db.String(100), default="website")  # website/phone/referral
    # Status
    status        = db.Column(db.String(50), default=LeadStatus.NEW)
    assigned_to   = db.Column(db.String(150))  # sales agent name/id
    notes         = db.Column(db.Text)
    # Audit
    created_at    = db.Column(db.DateTime, default=datetime.utcnow)
    updated_at    = db.Column(db.DateTime, default=datetime.utcnow, onupdate=datetime.utcnow)

    # Relationship
    booking       = db.relationship("TourBooking", back_populates="lead", uselist=False)

    def to_dict(self):
        return {c.name: getattr(self, c.name) for c in self.__table__.columns}

    def __repr__(self):
        return f"<Lead #{self.id} — {self.name} ({self.status})>"


# ─────────────────────────────────────────────────────────────────────────────
# 2. TOUR BOOKING  — confirmed tour package
# ─────────────────────────────────────────────────────────────────────────────

class TourBooking(db.Model):
    __tablename__ = "tour_bookings"

    id              = db.Column(db.Integer, primary_key=True)
    lead_id         = db.Column(db.Integer, db.ForeignKey("leads.id"), nullable=False, unique=True)
    booking_ref     = db.Column(db.String(30), unique=True, nullable=False)  # e.g. TB-2026-0001
    # Tour details (copied from lead, can be adjusted)
    client_name     = db.Column(db.String(150), nullable=False)
    client_email    = db.Column(db.String(255), nullable=False)
    client_phone    = db.Column(db.String(50))
    pax             = db.Column(db.Integer, default=1)
    arrival_date    = db.Column(db.Date, nullable=False)
    departure_date  = db.Column(db.Date, nullable=False)
    destination     = db.Column(db.String(255))
    tour_type       = db.Column(db.String(100))
    language        = db.Column(db.String(50))
    # Pricing
    total_price     = db.Column(db.Numeric(12, 2), default=0)
    currency        = db.Column(db.String(10), default="USD")
    # Status & workflow
    status          = db.Column(db.String(50), default=BookingStatus.DRAFT)
    excel_row_ref   = db.Column(db.String(100))   # reference to master Excel row
    to_confirmation_sent_at = db.Column(db.DateTime)  # when 45-day confirmation was sent
    services_rendered = db.Column(db.Boolean, default=False)
    # Audit
    created_by      = db.Column(db.String(150))
    created_at      = db.Column(db.DateTime, default=datetime.utcnow)
    updated_at      = db.Column(db.DateTime, default=datetime.utcnow, onupdate=datetime.utcnow)

    # Relationships
    lead                  = db.relationship("Lead", back_populates="booking")
    hotel_requests        = db.relationship("HotelRequest",        back_populates="booking", cascade="all, delete-orphan")
    restaurant_requests   = db.relationship("RestaurantRequest",   back_populates="booking", cascade="all, delete-orphan")
    transport_assignments = db.relationship("TransportAssignment", back_populates="booking", cascade="all, delete-orphan")
    guide_assignments     = db.relationship("GuideAssignment",     back_populates="booking", cascade="all, delete-orphan")
    railway_tickets       = db.relationship("RailwayTicket",       back_populates="booking", cascade="all, delete-orphan")
    aviation_tickets      = db.relationship("AviationTicket",      back_populates="booking", cascade="all, delete-orphan")
    accounting            = db.relationship("AccountingRecord",    back_populates="booking", uselist=False, cascade="all, delete-orphan")

    def to_dict(self):
        d = {c.name: getattr(self, c.name) for c in self.__table__.columns}
        d["total_price"] = float(d["total_price"]) if d["total_price"] else 0
        return d

    def __repr__(self):
        return f"<TourBooking {self.booking_ref} — {self.client_name}>"


