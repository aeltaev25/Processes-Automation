# 10. AUDIT LOG
# ─────────────────────────────────────────────────────────────────────────────

class AuditLog(db.Model):
    """Immutable append-only log of every status change / action."""
    __tablename__ = "audit_logs"

    id            = db.Column(db.Integer, primary_key=True)
    entity_type   = db.Column(db.String(100))   # "lead", "hotel_request", etc.
    entity_id     = db.Column(db.Integer)
    action        = db.Column(db.String(100))   # "status_changed", "email_sent", etc.
    old_value     = db.Column(db.Text)
    new_value     = db.Column(db.Text)
    performed_by  = db.Column(db.String(150))   # username or "system"
    performed_at  = db.Column(db.DateTime, default=datetime.utcnow)
    details       = db.Column(db.Text)

    @classmethod
    def log(cls, entity_type, entity_id, action, old_value=None,
            new_value=None, performed_by="system", details=None):
        entry = cls(
            entity_type=entity_type,
            entity_id=entity_id,
            action=action,
            old_value=str(old_value) if old_value is not None else None,
            new_value=str(new_value) if new_value is not None else None,
            performed_by=performed_by,
            details=details,
        )
        db.session.add(entry)
        # caller must commit
        return entry