class Driver(db.Model):
    __tablename__ = "drivers"

    id            = db.Column(db.Integer, primary_key=True)
    full_name     = db.Column(db.String(150), nullable=False)
    phone         = db.Column(db.String(50))
    telegram_id   = db.Column(db.String(100))
    car_type      = db.Column(db.String(100))   # sedan, minivan, bus, etc.
    car_plate     = db.Column(db.String(30))
    car_capacity  = db.Column(db.Integer)
    languages     = db.Column(db.String(100))   # languages driver speaks
    is_active     = db.Column(db.Boolean, default=True)
    created_at    = db.Column(db.DateTime, default=datetime.utcnow)

    assignments   = db.relationship("TransportAssignment", back_populates="driver")

    def to_dict(self):
        return {c.name: getattr(self, c.name) for c in self.__table__.columns}


class TransportAssignment(db.Model):
    """
    Covers both 'CAR 4 TOURS' (sightseeing vehicle) and 'TRANSFERS'
    (airport / station pickup/drop-off).
    """
    __tablename__ = "transport_assignments"

    id              = db.Column(db.Integer, primary_key=True)
    booking_id      = db.Column(db.Integer, db.ForeignKey("tour_bookings.id"), nullable=False)
    driver_id       = db.Column(db.Integer, db.ForeignKey("drivers.id"), nullable=True)
    transport_type  = db.Column(db.String(50))  # "tour_car" | "transfer"
    # Schedule
    service_date    = db.Column(db.Date,   nullable=False)
    service_time    = db.Column(db.String(20))   # e.g. "09:00"
    pickup_location = db.Column(db.String(255))
    dropoff_location= db.Column(db.String(255))
    geo_link        = db.Column(db.String(500))  # Google Maps link sent to driver
    route_notes     = db.Column(db.Text)         # itinerary / stops
    pax             = db.Column(db.Integer)
    car_type_needed = db.Column(db.String(100))
    # Workflow status
    status          = db.Column(db.String(50), default=TransportStatus.PLANNED)
    assigned_at     = db.Column(db.DateTime)
    reminder_sent_at= db.Column(db.DateTime)     # 1-day-before reminder timestamp
    program_sent_at = db.Column(db.DateTime)     # program (geo+contacts) sent to driver
    # Accounting
    price           = db.Column(db.Numeric(10, 2))
    driver_fee      = db.Column(db.Numeric(10, 2))
    driver_paid     = db.Column(db.Boolean, default=False)
    driver_paid_at  = db.Column(db.DateTime)
    invoice_sent_to_accounting = db.Column(db.Boolean, default=False)
    monthly_reconciled = db.Column(db.Boolean, default=False)
    notes           = db.Column(db.Text)
    created_at      = db.Column(db.DateTime, default=datetime.utcnow)
    updated_at      = db.Column(db.DateTime, default=datetime.utcnow, onupdate=datetime.utcnow)

    booking         = db.relationship("TourBooking", back_populates="transport_assignments")
    driver          = db.relationship("Driver",      back_populates="assignments")

    def to_dict(self):
        d = {c.name: getattr(self, c.name) for c in self.__table__.columns}
        for key in ("price", "driver_fee"):
            if d.get(key) is not None:
                d[key] = float(d[key])
        return d


