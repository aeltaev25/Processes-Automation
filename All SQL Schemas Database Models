# 9. ACCOUNTING RECORD  — master financial record per booking
# ─────────────────────────────────────────────────────────────────────────────

class AccountingRecord(db.Model):
    __tablename__ = "accounting_records"

    id              = db.Column(db.Integer, primary_key=True)
    booking_id      = db.Column(db.Integer, db.ForeignKey("tour_bookings.id"), nullable=False, unique=True)
    # Revenue (what client pays us)
    quoted_price    = db.Column(db.Numeric(12, 2), default=0)
    received_amount = db.Column(db.Numeric(12, 2), default=0)
    currency        = db.Column(db.String(10), default="USD")
    payment_status  = db.Column(db.String(50), default=PaymentStatus.UNPAID)
    payment_method  = db.Column(db.String(50))   # bank_transfer, cash, card
    payment_date    = db.Column(db.Date)
    # Cost (what we pay suppliers)
    hotel_cost      = db.Column(db.Numeric(12, 2), default=0)
    restaurant_cost = db.Column(db.Numeric(12, 2), default=0)
    transport_cost  = db.Column(db.Numeric(12, 2), default=0)
    guide_cost      = db.Column(db.Numeric(12, 2), default=0)
    railway_cost    = db.Column(db.Numeric(12, 2), default=0)
    aviation_cost   = db.Column(db.Numeric(12, 2), default=0)
    other_cost      = db.Column(db.Numeric(12, 2), default=0)
    # Calculated
    total_cost      = db.Column(db.Numeric(12, 2), default=0)   # sum of all costs
    gross_profit    = db.Column(db.Numeric(12, 2), default=0)   # revenue - cost
    # Final reconciliation
    all_invoices_collected = db.Column(db.Boolean, default=False)
    final_reconciliation_done = db.Column(db.Boolean, default=False)
    reconciled_at   = db.Column(db.DateTime)
    reconciled_by   = db.Column(db.String(150))
    # Status
    status          = db.Column(db.String(50), default="open")   # open / closed
    closed_at       = db.Column(db.DateTime)
    closed_by       = db.Column(db.String(150))
    notes           = db.Column(db.Text)
    created_at      = db.Column(db.DateTime, default=datetime.utcnow)
    updated_at      = db.Column(db.DateTime, default=datetime.utcnow, onupdate=datetime.utcnow)

    booking         = db.relationship("TourBooking",  back_populates="accounting")
    invoices        = db.relationship("Invoice",      back_populates="accounting", cascade="all, delete-orphan")

    def recalculate(self):
        """Recompute totals from child invoice amounts."""
        self.total_cost  = (
            (self.hotel_cost      or 0) +
            (self.restaurant_cost or 0) +
            (self.transport_cost  or 0) +
            (self.guide_cost      or 0) +
            (self.railway_cost    or 0) +
            (self.aviation_cost   or 0) +
            (self.other_cost      or 0)
        )
        self.gross_profit = (self.quoted_price or 0) - self.total_cost

    def to_dict(self):
        d = {c.name: getattr(self, c.name) for c in self.__table__.columns}
        for key in ("quoted_price","received_amount","hotel_cost","restaurant_cost",
                    "transport_cost","guide_cost","railway_cost","aviation_cost",
                    "other_cost","total_cost","gross_profit"):
            if d.get(key) is not None:
                d[key] = float(d[key])
        return d


