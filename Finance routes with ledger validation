/**
 * ADVANTOUR — Finance Routes
 *
 * Implements a double-entry bookkeeping ledger.
 * Core invariant: SUM(debit) = SUM(credit) for every journal entry.
 * This is enforced at the DB level with a trigger AND at the API level here.
 *
 * Endpoints:
 *   GET  /api/v1/finance/accounts          — chart of accounts
 *   GET  /api/v1/finance/journal           — journal entries list
 *   POST /api/v1/finance/journal           — post new journal entry
 *   GET  /api/v1/finance/balances          — account balances
 *   GET  /api/v1/finance/reports/pnl       — P&L summary
 */

'use strict';

const express = require('express');
const router  = express.Router();
const { authenticate, authorize } = require('../middleware/auth');
const { withTransaction, query } = require('../config/database');
const { AppError } = require('../middleware/errorHandler');
const logger = require('../config/logger');

// Only finance role and admin can access these routes
const financeAuth = [authenticate, authorize('admin', 'finance')];

// ── GET /api/v1/finance/accounts ─────────────────────────────────────────────
router.get('/accounts', ...financeAuth, async (req, res, next) => {
  try {
    const result = await query(
      `SELECT account_id, code, name, type, parent_id
       FROM ledger_accounts
       WHERE is_active = true
       ORDER BY code`
    );
    res.json(result.rows);
  } catch (err) {
    next(err);
  }
});

// ── POST /api/v1/finance/journal ─────────────────────────────────────────────
//    Posts a new double-entry journal entry.
//    Body: { reference_id, description, lines: [{ account_id, debit, credit }] }
router.post('/journal', ...financeAuth, async (req, res, next) => {
  try {
    const { reference_id, description, lines } = req.body;

    if (!lines || lines.length < 2) {
      throw new AppError('Journal entry requires at least 2 lines (debit and credit)', 400);
    }

    // Validate double-entry balance IN THE APPLICATION (belt-and-suspenders;
    // the DB trigger is the authoritative check)
    const totalDebit  = lines.reduce((sum, l) => sum + parseFloat(l.debit  || 0), 0);
    const totalCredit = lines.reduce((sum, l) => sum + parseFloat(l.credit || 0), 0);

    if (Math.abs(totalDebit - totalCredit) > 0.001) {
      throw new AppError(
        `Ledger imbalance: debits (${totalDebit}) ≠ credits (${totalCredit})`,
        422,
        'LEDGER_IMBALANCE'
      );
    }

    const entry = await withTransaction(async (client) => {
      // 1. Create the journal entry header
      const entryResult = await client.query(
        `INSERT INTO journal_entries (reference_id, description, created_by)
         VALUES ($1, $2, $3)
         RETURNING *`,
        [reference_id, description, req.user.userId]
      );
      const journalEntry = entryResult.rows[0];

      // 2. Insert each line
      for (const line of lines) {
        await client.query(
          `INSERT INTO journal_lines (entry_id, account_id, debit, credit)
           VALUES ($1, $2, $3, $4)`,
          [journalEntry.entry_id, line.account_id,
           parseFloat(line.debit  || 0),
           parseFloat(line.credit || 0)]
        );
      }

      // The DB trigger validate_journal_balance() fires here and
      // will ROLLBACK the entire transaction if debits ≠ credits.

      return journalEntry;
    });

    logger.info(`Journal entry posted: ${entry.entry_id} by ${req.user.email}`);
    res.status(201).json(entry);
  } catch (err) {
    next(err);
  }
});

// ── GET /api/v1/finance/balances ─────────────────────────────────────────────
router.get('/balances', ...financeAuth, async (req, res, next) => {
  try {
    const result = await query(
      `SELECT
         a.account_id,
         a.code,
         a.name,
         a.type,
         COALESCE(SUM(l.debit),  0) AS total_debit,
         COALESCE(SUM(l.credit), 0) AS total_credit,
         COALESCE(SUM(l.debit) - SUM(l.credit), 0) AS balance
       FROM ledger_accounts a
       LEFT JOIN journal_lines l ON l.account_id = a.account_id
       WHERE a.is_active = true
       GROUP BY a.account_id, a.code, a.name, a.type
       ORDER BY a.code`
    );
    res.json(result.rows);
  } catch (err) {
    next(err);
  }
});

// ── GET /api/v1/finance/reports/pnl ─────────────────────────────────────────
//    Returns monthly P&L summary for dashboards / executive reporting.
router.get('/reports/pnl', ...financeAuth, async (req, res, next) => {
  try {
    const year = parseInt(req.query.year || new Date().getFullYear());

    const result = await query(
      `SELECT
         DATE_TRUNC('month', je.created_at) AS month,
         a.type,
         SUM(jl.credit - jl.debit) AS net
       FROM journal_lines jl
       JOIN journal_entries je ON jl.entry_id = je.entry_id
       JOIN ledger_accounts  a  ON jl.account_id = a.account_id
       WHERE EXTRACT(YEAR FROM je.created_at) = $1
         AND a.type IN ('revenue', 'expense')
       GROUP BY month, a.type
       ORDER BY month ASC`,
      [year]
    );

    res.json(result.rows);
  } catch (err) {
    next(err);
  }
});

module.exports = router;